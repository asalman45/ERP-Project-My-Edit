{
  "name": "erp-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "node -e \"import('fs').then(fs => { const p='node_modules/@makeorbreakshop/any-nest/package.json'; if(fs.existsSync(p)){ const d=JSON.parse(fs.readFileSync(p)); d.type='module'; fs.writeFileSync(p, JSON.stringify(d, null, 2)); } })\"",
    "dev": "cross-env NODE_ENV=development npx tsx watch src/index.js",
    "start": "cross-env NODE_ENV=production node --experimental-specifier-resolution=node src/index.js",
    "migrate": "node migrations/run-migrations.js",
    "seed": "node migrations/run-migrations.js --seed",
    "seed:customers": "ts-node prisma/seed/import_customers.ts",
    "seed:balances": "ts-node prisma/seed/import_balances.ts",
    "seed:vendors": "ts-node prisma/seed/fetch_and_dump_vendors.ts",
    "seed:banks": "ts-node prisma/seed/fetch_and_dump_banks.ts",
    "lint": "eslint . --ext .js"
  },
  "dependencies": {
    "@makeorbreakshop/any-nest": "^1.1.0",
    "@prisma/client": "^6.16.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "cross-env": "^10.0.0",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "dxf-parser": "^1.1.2",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "handlebars": "^4.7.8",
    "helmet": "^7.0.0",
    "html-pdf-node": "^1.0.8",
    "html2canvas": "^1.4.1",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "maxrects-packer": "^2.7.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.9",
    "pg": "^8.11.0",
    "pino": "^8.16.0",
    "prisma": "^6.16.1",
    "puppeteer": "^24.24.0",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^8.48.0",
    "nodemon": "^3.0.1",
    "pino-pretty": "^13.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
